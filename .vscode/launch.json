{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Turla Mobil",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/mobile",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=../../.env"]
    },
    {
      "name": "Turla Web Panel",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/web",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--dart-define-from-file=../../.env"]
    }
  ]
}
